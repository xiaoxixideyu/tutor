# OpenAI 兼容模型接入（设计文档 §6.3：base_url + api_key + model 三配置，不绑定供应商）
# 可选：复制为 .env 并填入真实值；也可启动网页后在“模型设置”填写。
# 网页保存的配置优先于环境变量和 .env；.env 已被 .gitignore 排除。
TUTOR_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
TUTOR_LLM_API_KEY=sk-xxxxxxxx
TUTOR_LLM_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct
# TUTOR_LLM_CONTEXT_WINDOW=262144
# 可指定独立的网页配置文件（建议绝对路径）；默认 data/model-config.json
# TUTOR_MODEL_CONFIG_FILE=/absolute/path/model-config.json

# 联网教研（二期，可选）：MCP 搜索服务（searchix，Streamable HTTP）
TUTOR_MCP_SEARCH_URL=https://search.604020.xyz/mcp
TUTOR_MCP_SEARCH_TOKEN=sk-proxy-xxxxxxxx

# ---- 第二期：教研网搜（MCP searchix）----
TUTOR_MCP_SEARCH_URL=https://search.604020.xyz/mcp
TUTOR_MCP_SEARCH_TOKEN=sk-proxy-xxxx
