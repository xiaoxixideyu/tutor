# OpenAI 兼容渠道；网页保存的配置优先于环境变量和本文件
TUTOR_LLM_BASE_URL=https://api.example.com/v1
TUTOR_LLM_API_KEY=
TUTOR_LLM_MODEL=
TUTOR_LLM_CONTEXT_WINDOW=262144
TUTOR_LLM_MAX_OUTPUT_TOKENS=16384
TUTOR_LLM_REQUESTS_PER_MINUTE=8
TUTOR_AGENT_THINKING=low
TUTOR_REVIEW_THINKING=low

# 同一渠道的可选角色模型，留空使用全局模型
TUTOR_AGENT_MODEL=
TUTOR_REVIEW_MODEL=
TUTOR_SOLVER_MODEL=
TUTOR_GRADER_MODEL=
TUTOR_RESEARCH_MODEL=
TUTOR_REPAIR_MODEL=

# 判断方式可选；llm 为默认，typesafe 启用快速辅助判断
# 关闭后无需快速判断服务或额外密钥。网页选择优先于以下环境设置。
TUTOR_JUDGMENT_PROVIDER=llm
TUTOR_JUDGMENT_BASE_URL=https://api.typesafe.ai/v1
TUTOR_JUDGMENT_MODEL=jev-latest
TUTOR_JUDGMENT_API_KEY=
TUTOR_JUDGMENT_MIN_CONFIDENCE=0.95
TUTOR_JUDGMENT_TIMEOUT_MS=5000
TUTOR_JUDGMENT_REQUESTS_PER_MINUTE=60

# 可选搜索 MCP
TUTOR_MCP_SEARCH_URL=
TUTOR_MCP_SEARCH_TOKEN=

# 每个教学回合和每天的估算预算，计入所有角色调用与重试
TUTOR_AGENT_MAX_REQUESTS=16
TUTOR_AGENT_MAX_STEPS=6
TUTOR_SESSION_COST_LIMIT=2
TUTOR_DAILY_COST_LIMIT=10
TUTOR_DAILY_REQUEST_LIMIT=100
TUTOR_TURN_DEADLINE_MS=420000

# 本机服务器与日历时区
TUTOR_SERVER_PORT=8788
TUTOR_TIMEZONE=Asia/Shanghai
# TUTOR_COURSES_ROOT=/absolute/path/to/courses
# TUTOR_DATA_ROOT=/absolute/path/to/runtime
