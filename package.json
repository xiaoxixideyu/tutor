{
  "name": "tutor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "个性化教学 agent：从需求澄清、教研、摸底、规划，到讲授、检验、复习，全程因材施教",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "agent": "node scripts/agent.mjs",
    "serve": "node scripts/agent.mjs serve",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit && node scripts/check-syntax.mjs",
    "eval:agent": "node scripts/eval-agent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
