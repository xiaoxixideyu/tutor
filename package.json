{
  "name": "tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个性化教学 agent：从需求澄清、教研、摸底、规划，到讲授、检验、复习，全程因材施教",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "agent": "node scripts/agent.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:grading": "node scripts/eval-grading.mjs",
    "eval:content": "node scripts/eval-content.mjs",
    "eval:content:all": "node scripts/eval-content-suite.mjs",
    "serve": "node scripts/agent.mjs serve",
    "trial": "node scripts/trial.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "tldts": "7.4.18",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
